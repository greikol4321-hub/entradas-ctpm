# CTPM — .env.example (copiar a .env y completar)
FLASK_SECRET=cambia-esto-por-64-chars-aleatorios-en-produccion
SINPE_NUMERO=8888-8888
SINPE_NOMBRE=Asociación CTPM
# Supabase Postgres (recomendado) - pooler 6543
DATABASE_URL=postgresql://USER:PASS@HOST:6543/postgres
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhb...
# Rate limit distribuido (opcional, recomendado en Vercel)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
# Observabilidad (opcional)
SENTRY_DSN=https://xxx@o123.ingest.sentry.io/123
# Admin inicial (solo se crea si no existe)
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=cambia-esto-min-12-chars
